# Senha do Postgres do docker compose (OBRIGATÓRIA para subir o compose — não
# há senha padrão). Só caracteres seguros para URL (ex. hex), pois ela entra no
# DATABASE_URL. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# Banco PostgreSQL (obrigatório fora do docker compose — o compose já injeta).
# Na Via B (npm run dev + banco do compose) use a mesma senha acima:
DATABASE_URL=postgres://vitta:<POSTGRES_PASSWORD>@localhost:5432/vitta

# Pool de conexões (opcionais — padrões entre parênteses)
# PG_POOL_MAX=10               # conexões simultâneas por instância (10)
# PG_CONNECT_TIMEOUT_MS=5000   # espera por conexão livre no pool (5s)
# PG_IDLE_TIMEOUT_MS=30000     # fecha conexão ociosa (30s)
# PG_STATEMENT_TIMEOUT_MS=15000 # aborta query longa (15s)

# Rate limit geral de /api/* (opcional): req/min por conta autenticada (por IP
# para anônimos), somado entre réplicas. Padrão 120.
# API_RATE_LIMIT_MAX=120
# Proxies reversos confiáveis à frente do app — define qual IP do
# x-forwarded-for é o do cliente. Nginx/Caddy = 1 (padrão), Cloudflare + Nginx = 2.
# Em produção, requisição sem x-forwarded-for gera um aviso no log.
# TRUSTED_PROXY_HOPS=1

# Migrações: por padrão rodam no boot com advisory lock (seguro com réplicas).
# Em deploys com step dedicado, rode `npm run db:migrate` e desligue o boot-migrate:
# VITTA_MIGRATE_ON_BOOT=false

# Fuso horário da clínica. APP_TIMEZONE é o fuso das regras (grade da agenda,
# "amanhã" dos lembretes, horário nos e-mails/documentos); TZ é o do processo.
# Em produção a aplicação recusa subir se os dois divergirem.
TZ=America/Sao_Paulo
APP_TIMEZONE=America/Sao_Paulo

# Autenticação (OBRIGATÓRIO em produção — sem esta variável o sistema responde 503)
# Em desenvolvimento (NODE_ENV != production) pode ficar vazia com
# VITTA_ALLOW_OPEN_MODE=true: sistema roda aberto com aviso.
# Toda conta autentica com e-mail + senha própria (ADR-004): não existe senha
# mestre, allowlist de e-mails nem login via Google.
# Gere com: openssl rand -hex 32
AUTH_SECRET=

# Chave do dado clínico em repouso (OBRIGATÓRIA em produção, #195/ADR-006):
# cifra evoluções, anamnese, notas e o token do Google. Separada do AUTH_SECRET —
# rotacionar o AUTH_SECRET não afeta o prontuário. Perdê-la é perder o dado
# cifrado: guarde-a no cofre de segredos, fora do backup do banco.
# Fora de produção pode ficar vazia (usa uma chave de desenvolvimento).
# Gere com: openssl rand -hex 32
DATA_ENCRYPTION_KEY=
# Rotação: a chave antiga vai para cá (lista separada por vírgula, só leitura),
# depois rode `npm run data:reencrypt`. Roteiro: docs/engineering/producao.md.
# DATA_ENCRYPTION_KEY_PREVIOUS=

# URL pública da aplicação — compõe os links de convite/reset e o redirect do OAuth da agenda.
APP_URL=http://localhost:3000

# ── E-mail transacional (OBRIGATÓRIO em produção) ───────────────────────────
# Convite de primeiro acesso e reset de senha. Em produção, a ausência destas
# variáveis derruba a inicialização com erro claro; fora de produção o gateway
# cai em dry-run (loga o link em vez de enviar).
# https://resend.com → API Keys
RESEND_API_KEY=
# Remetente verificado no provedor, ex.: "VittaFlow <nao-responda@suaclinica.com>"
EMAIL_FROM=

# ── Bootstrap do primeiro Super Admin ───────────────────────────────────────
# Segredo de deploy que libera POST /api/auth/bootstrap enquanto a instalação
# não tem NENHUMA conta. Depois da primeira conta a rota responde 403 para
# sempre. Sem esta variável não há caminho de bootstrap (fail-closed).
# Gere com: openssl rand -hex 24
VITTA_BOOTSTRAP_TOKEN=

# ── Google Calendar via OAuth — integração opcional, sem relação com login ──
# Conectada por uma conta já autenticada em /configuracoes → "Conectar Google Agenda".
# 1. Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# 2. Authorized redirect URI: {APP_URL}/api/integrations/google-calendar/callback
# 3. Habilite a Google Calendar API no projeto.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google Calendar via service account — alternativa sem OAuth ─────────────
# Usada apenas quando nenhuma conta Google está conectada via OAuth.
# Compartilhe o calendário com o email da service account (permissão "Fazer alterações").
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Com OAuth: destino dos eventos (padrão "primary" = calendário da conta logada).
# Com service account: id do calendário compartilhado (obrigatório nesse modo).
GOOGLE_CALENDAR_ID=

# ── Fotos de evolução (F6) ──────────────────────────────────────────────────
# Diretório dos arquivos de foto (fora do public/; monte um volume no Docker).
# UPLOADS_DIR=./uploads
# Várias réplicas: guarde as fotos num bucket S3-compatível (AWS S3, Cloudflare
# R2, MinIO). Bucket PRIVADO. Migração: copie o conteúdo de uploads/ para o
# bucket (as chaves são os mesmos caminhos: <clinicId>/condition-photos/<id>).
# PHOTO_STORAGE=s3
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto            # R2: auto · AWS: ex. sa-east-1
# S3_ENDPOINT=              # vazio = AWS S3 · R2: https://<conta>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false # true para MinIO
# Cifra das fotos no bucket: AES256 (padrão), aws:kms, ou provider (sem cabeçalho,
# para provedor que já cifra em repouso e rejeita o cabeçalho).
# S3_SSE=AES256

# ── Documentos clínicos (F7) — cabeçalho/assinatura ─────────────────────────
# CLINIC_NAME=VittaFlow — Clínica de Estomaterapia
# CLINIC_CNPJ=
# CLINIC_ADDRESS=
# CLINIC_CITY=
# CLINIC_PROFESSIONAL_NAME=
# CLINIC_PROFESSIONAL_REGISTRY=COREN-SP 000000

# ── Lembretes ao paciente (job diário por e-mail) ───────────────────────────
# O job envia confirmação D-1 e recall por e-mail (Resend, acima). Sem CRON_SECRET a
# rota responde 503 e nenhum lembrete sai — obrigatório para o go-live dos lembretes.
# Disparo: POST /api/reminders/run com header x-cron-secret, ou GET com
# Authorization: Bearer (formato do Vercel Cron, ver vercel.json).
# Gere com: openssl rand -hex 24
# CRON_SECRET=
#
# WhatsApp pela Meta Cloud API (RM-14, Later): fora do job. O WhatsApp hoje sai pelo
# botão "Enviar WhatsApp" (wa.me), sem credencial. Só para o opt-in futuro:
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ── Suíte E2E (Playwright) — opcional ───────────────────────────────────────
# Por padrão a suíte gera estes valores a cada execução e os propaga aos workers e ao
# servidor que ela mesma sobe (ver e2e/support/constants.ts) — não é preciso definir nada.
#
# Só defina para reaproveitar um `npm run dev` iniciado à parte. Nesse caso o
# webServer.env do Playwright não é aplicado, então os pares precisam bater:
# E2E_AUTH_SECRET/E2E_BOOTSTRAP_TOKEN para a suíte e
# AUTH_SECRET/VITTA_BOOTSTRAP_TOKEN (mesmos valores) para o servidor.
# E2E_AUTH_SECRET=
# E2E_BOOTSTRAP_TOKEN=
