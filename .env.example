# Senha do Postgres do docker compose (OBRIGATÓRIA para subir o compose — não
# há senha padrão). Só caracteres seguros para URL (ex. hex), pois ela entra no
# DATABASE_URL. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# Portas publicadas pelo compose no host (opcionais): POSTGRES_PORT (5432, só
# loopback) e APP_PORT (3000).
# POSTGRES_PORT=5432
# APP_PORT=3000

# Banco PostgreSQL (obrigatório fora do docker compose — o compose já injeta).
# Na Via B (npm run dev + banco do compose) use a mesma senha acima:
DATABASE_URL=postgres://estomasystech:<POSTGRES_PASSWORD>@localhost:5432/estomasystech

# Suíte de integração (npm run test:integracao): Postgres LOCAL com usuário que cria bancos,
# no lugar do db do compose (dispensa o Docker). Recusa banco de produção ou remoto.
# INTEGRATION_DATABASE_URL=postgres://estomasystech:<senha>@127.0.0.1:5432/postgres

# Pool de conexões (opcionais — padrões entre parênteses)
# PG_POOL_MAX=10               # conexões simultâneas por instância (10)
# PG_CONNECT_TIMEOUT_MS=5000   # espera por conexão livre no pool (5s)
# PG_IDLE_TIMEOUT_MS=30000     # fecha conexão ociosa (30s)
# PG_STATEMENT_TIMEOUT_MS=15000 # aborta query longa (15s)

# Rate limit geral de /api/* (opcional): req/min por conta autenticada (por IP
# para anônimos), somado entre réplicas. Padrão 120.
# API_RATE_LIMIT_MAX=120
# ACTION_RATE_LIMIT_MAX=120
# Proxies reversos confiáveis à frente do app — define qual IP do
# x-forwarded-for é o do cliente. Nginx/Traefik = 1 (padrão), Cloudflare + Nginx = 2.
# Em produção, requisição sem x-forwarded-for gera um aviso no log.
# TRUSTED_PROXY_HOPS=1

# Migrações: por padrão rodam no boot com advisory lock (seguro com réplicas).
# Em deploys com step dedicado, rode `npm run db:migrate` e desligue o boot-migrate:
# ESTOMASYSTECH_MIGRATE_ON_BOOT=false

# Só a suíte E2E liga (os playwright*.config.ts já definem): deixa o teste fazer uma leitura
# do servidor falhar pelo cookie `e2e-fault`. Nunca em produção.
# ESTOMASYSTECH_E2E_FAULTS=1

# Fuso horário da clínica. APP_TIMEZONE é o fuso das regras (grade da agenda,
# "amanhã" dos lembretes, horário nos e-mails/documentos); TZ é o do processo.
# Em produção a aplicação recusa subir se os dois divergirem. O cliente recebe o
# mesmo fuso no build (derivado de APP_TIMEZONE; ADR-073). Não defina à mão:
# NEXT_PUBLIC_APP_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo
APP_TIMEZONE=America/Sao_Paulo

# Autenticação (OBRIGATÓRIO em produção — sem esta variável o sistema responde 503)
# Não existe modo sem autenticação (removido na #327): sem ela, tudo responde 503.
# Toda conta autentica com e-mail + senha própria (ADR-004): não existe senha
# mestre, allowlist de e-mails nem login via Google.
# Gere com: openssl rand -hex 32
AUTH_SECRET=

# Chave do dado clínico em repouso (OBRIGATÓRIA em produção, #195/ADR-006):
# cifra evoluções, anamnese, notas e o token do Google. Separada do AUTH_SECRET —
# rotacionar o AUTH_SECRET não afeta o prontuário. Perdê-la é perder o dado
# cifrado: guarde-a no cofre de segredos, fora do backup do banco.
# Fora de produção pode ficar vazia (usa uma chave de desenvolvimento).
# Gere com: openssl rand -hex 32
DATA_ENCRYPTION_KEY=
# Rotação: a chave antiga vai para cá (lista separada por vírgula, só leitura),
# depois rode `npm run data:reencrypt`. Roteiro: docs/engineering/producao.md.
# DATA_ENCRYPTION_KEY_PREVIOUS=

# URL pública da aplicação — compõe os links de convite/reset e o redirect do OAuth da agenda.
APP_URL=http://localhost:3000
# Só na Vercel (homologação): domínio de produção do projeto, injetado pela plataforma; usado como
# base dos links de convite quando APP_URL não está definida. Não defina à mão.
# VERCEL_PROJECT_PRODUCTION_URL=

# ── E-mail da plataforma (opcional, ADR-011) ────────────────────────────────
# Só para as contas sem clínica (Super Admin): bootstrap e reset de senha dele.
# Os e-mails de cada clínica saem pela chave que a própria clínica cadastra
# (tabela clinic_channels), nunca por estas. Sem elas o canal da plataforma
# fica desativado — também em produção; fora de produção o gateway nulo loga o
# link de senha em vez de enviar.
# https://resend.com → API Keys
RESEND_API_KEY=
# Remetente verificado no provedor, ex.: "EstomaSysTech <nao-responda@suaclinica.com>"
EMAIL_FROM=

# ── Bootstrap do primeiro Super Admin ───────────────────────────────────────
# Segredo de deploy que libera POST /api/auth/bootstrap enquanto a instalação
# não tem NENHUMA conta. Depois da primeira conta a rota responde 403 para
# sempre. Sem esta variável não há caminho de bootstrap (fail-closed).
# Gere com: openssl rand -hex 24
ESTOMASYSTECH_BOOTSTRAP_TOKEN=

# ── Google Calendar via OAuth — integração opcional, sem relação com login ──
# Conectada por uma conta já autenticada em /configuracoes → "Conectar Google Agenda".
# 1. Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# 2. Authorized redirect URI: {APP_URL}/api/integrations/google-calendar/callback
# 3. Habilite a Google Calendar API no projeto.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google Calendar via service account — alternativa sem OAuth ─────────────
# Usada apenas quando nenhuma conta Google está conectada via OAuth.
# Compartilhe o calendário com o email da service account (permissão "Fazer alterações").
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Com OAuth: destino dos eventos (padrão "primary" = calendário da conta logada).
# Com service account: id do calendário compartilhado (obrigatório nesse modo).
GOOGLE_CALENDAR_ID=

# ── Fotos de evolução (F6) ──────────────────────────────────────────────────
# Diretório dos arquivos de foto (fora do public/; monte um volume no Docker).
# UPLOADS_DIR=./uploads
# Várias réplicas: guarde as fotos num bucket S3-compatível (AWS S3, Cloudflare
# R2, MinIO). Bucket PRIVADO. Migração: copie o conteúdo de uploads/ para o
# bucket (as chaves são os mesmos caminhos: <clinicId>/condition-photos/<id>).
# PHOTO_STORAGE=s3
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto            # R2: auto · AWS: ex. sa-east-1
# S3_ENDPOINT=              # vazio = AWS S3 · R2: https://<conta>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false # true para MinIO
# Cifra das fotos no bucket: AES256 (padrão), aws:kms, ou provider (sem cabeçalho,
# para provedor que já cifra em repouso e rejeita o cabeçalho).
# S3_SSE=AES256

# ── Lembretes ao paciente (job diário por e-mail) ───────────────────────────
# O job envia confirmação D-1 e recall por e-mail (Resend, acima). Sem CRON_SECRET a
# rota responde 503 e nenhum lembrete sai — obrigatório para o go-live dos lembretes.
# Disparo: POST /api/reminders/run com header x-cron-secret, ou GET com
# Authorization: Bearer (formato do Vercel Cron, ver vercel.json).
# Gere com: openssl rand -hex 24
# CRON_SECRET=
# Aviso ao Admin de pedido do titular (LGPD) perto do prazo de 15 dias: quantos dias antes
# do vencimento (1 a 14). Padrão 3.
# DATA_REQUEST_ALERT_DAYS=3

# ── Suíte E2E (Playwright) — opcional ───────────────────────────────────────
# Por padrão a suíte gera estes valores a cada execução e os propaga aos workers e ao
# servidor que ela mesma sobe (ver e2e/support/constants.ts) — não é preciso definir nada.
#
# Só defina para reaproveitar um `npm run dev` iniciado à parte. Nesse caso o
# webServer.env do Playwright não é aplicado, então os pares precisam bater:
# E2E_AUTH_SECRET/E2E_BOOTSTRAP_TOKEN para a suíte e
# AUTH_SECRET/ESTOMASYSTECH_BOOTSTRAP_TOKEN (mesmos valores) para o servidor.
# E2E_AUTH_SECRET=
# E2E_BOOTSTRAP_TOKEN=
# E2E_DATA_ENCRYPTION_KEY=
# Senhas que as contas da suíte definem no convite (também geradas por execução):
# E2E_ADMIN_PASSWORD=
# E2E_CLINIC_ADMIN_PASSWORD=
# E2E_ROLE_PASSWORD=

# ── Observabilidade (#212, ADR-014) ─────────────────────────────────────────
# Error tracking no GlitchTip self-hosted (docker-compose.glitchtip.yml). Vazio = sem
# error tracking (o app funciona igual). Na VPS: http://<chave>@glitchtip:8000/<projeto>.
# GLITCHTIP_DSN=
# Versão que aparece em cada evento do GlitchTip (ex. o commit do deploy).
# APP_RELEASE=
# Senha do Postgres e chave do próprio GlitchTip (só com docker-compose.glitchtip.yml).
# GLITCHTIP_DB_PASSWORD=     # openssl rand -hex 24
# GLITCHTIP_SECRET_KEY=      # openssl rand -hex 32
#
# Alertas por e-mail ao operador (POST /api/alerts/run, cron a cada 5 min), pelo canal
# da plataforma (RESEND_API_KEY/EMAIL_FROM). Sem destinatário ou sem canal, o alerta
# vira linha de erro no log (e evento no GlitchTip).
# ALERT_EMAIL_TO=operador@exemplo.com.br
# Limiares em 15 min (ponto de partida; pergunta aberta em docs/engineering/producao.md):
# ALERT_5XX_THRESHOLD=10
# ALERT_DELIVERY_FAILURE_THRESHOLD=3

# Homologação (Vercel/Neon, ADR-041, docs/engineering/homologacao.md). Nunca valores de produção.
# APP_ENV=staging                     # production | staging | preview | development
# MOCK_INTEGRATIONS=true              # MSW no lugar de Resend/Google/S3
# PRODUCTION_DB_HOSTS=db.exemplo.com  # hosts de produção que a homologação recusa
# STAGING_DISABLE_MFA=true            # só staging: login sem segundo fator (ADR-054); fora dela o app recusa subir
# STAGING_SEED_PASSWORD=              # senha das contas fictícias (npm run seed:staging)
# DATABASE_URL_UNPOOLED=              # conexão direta (migração no build)

# Versão exibida às clínicas (ADR-043). Definidas pelo next.config.ts no build; não ponha no .env.
# NEXT_PUBLIC_APP_VERSION=            # vem do package.json
# NEXT_PUBLIC_APP_COMMIT=             # SHA curto, só em homologação e preview
# VERCEL_GIT_COMMIT_SHA=              # injetada pela Vercel; origem de NEXT_PUBLIC_APP_COMMIT
# SOURCE_COMMIT=                     # injetada pelo Coolify; SHA gravado em app_releases (ADR-066)
#
# NEXT_PUBLIC_RELEASE_VERSION=        # calculada no build (package.json + changesets pendentes); não defina
# CHANGESET_BASE=origin/main          # base do npm run check:changeset
# GATE_BASE=origin/main               # base do diff que escolhe os arquivos da mutação no npm run gate:local
# GATE_PERFIL=release                 # perfil do gate:local (pr|release); o release:cut passa release (ADR-071)
# GATE_POSTGRES_PORT=55432            # força a porta do Postgres do compose no gate (padrão: 1ª livre a partir de 55432)
