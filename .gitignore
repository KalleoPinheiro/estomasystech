# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sqlite database
/data

# .env.example é modelo, deve ser versionado
!.env.example

# Fotos de evolução (dados sensíveis de pacientes — nunca versionar)
uploads/

# Configuração local do Claude Code (contém caminhos absolutos do $HOME e
# referência a outro projeto; a decisão de não versionar já tinha sido tomada).
# Exceção: settings.json/hooks/commands/agents são portáveis (sem paths
# absolutos) e precisam estar versionados pro harness-score contar de verdade
# (HKS-05 exige script de hook commitado) e pra outros devs/CI terem os mesmos
# guardrails e comandos. Skills de agente também: qualquer sessão (Claude Code
# ou Cursor) lê `.claude/skills` em vez da cópia da máquina de quem abriu.
/.claude/*
!/.claude/settings.json
!/.claude/hooks/
!/.claude/commands/
!/.claude/agents/
!/.claude/skills/

# Playwright E2E
/test-results/
/playwright-report/
/playwright/.cache/
/e2e/.auth/
/e2e/support/seed-data.json

# IA
.agents
# .cursor/ fica local, exceto as regras versionadas (pontes para AGENTS.md — docs/governance.md)
# e o symlink `.cursor/skills` → `../.claude/skills` (mesmas skills do Claude Code).
.cursor/*
!.cursor/rules/
!.cursor/skills
.windsurf
.tlc/harness/state/
.cursor/hooks.json
.claude/settings.json

# recibo do gate local (ADR-042)
/.gate/
/.ambiente-local/

# mutation testing (Stryker)
/reports/
/.stryker-tmp/
stryker.log
/.vitest-reports/
/.vitest-blob/
