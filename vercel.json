{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx tsx scripts/vercel-build.ts",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "staging": true
    }
  },
  "crons": [
    {
      "path": "/api/reminders/run",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/retention/run",
      "schedule": "0 6 * * *"
    }
  ]
}
