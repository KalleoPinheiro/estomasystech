{
  "name": "estomasystech",
  "version": "0.6.2",
  "private": true,
  "packageManager": "npm@11.21.1",
  "engines": {
    "node": ">=24.11 <25",
    "npm": "11.21.1"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "prebuild": "rm -rf .next/dev/types",
    "build": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "drizzle-kit migrate",
    "db:portal-orphans": "tsx scripts/report-portal-orphans.ts",
    "data:reencrypt": "tsx scripts/reencrypt-clinical-data.ts",
    "seed:staging": "tsx scripts/seed/run.ts",
    "ambiente:local": "tsx scripts/ambiente/local.ts up",
    "ambiente:local:down": "tsx scripts/ambiente/local.ts down",
    "test:integracao": "tsx scripts/ambiente/local.ts integracao",
    "staging:rebuild": "bash scripts/staging/rebuild.sh --deploy",
    "admin:recover": "tsx scripts/recover-super-admin.ts",
    "clinics:cnpj-review": "tsx scripts/flag-invalid-clinic-cnpjs.ts",
    "calendar:minimize": "tsx scripts/minimize-calendar-events.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "test:coverage": "vitest run --coverage",
    "test:mutacao": "TZ=UTC stryker run",
    "test:e2e": "npm run build && npm run test:e2e:prod && npm run test:e2e:dev",
    "test:e2e:prod": "playwright test -c playwright.prod.config.ts",
    "test:e2e:dev": "playwright test",
    "test:console": "npm run build && playwright test -c playwright.prod.config.ts console-limpo && playwright test -c playwright.console.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "import-taxonomy": "tsx scripts/import-taxonomy.ts",
    "check:sv": "bash scripts/check-sv-adoption.sh",
    "check:docs": "tsx scripts/check-docs.ts",
    "check:server-first": "tsx scripts/check-server-first.ts",
    "check:dynamic-import": "tsx scripts/check-dynamic-import.ts",
    "check:testes": "tsx scripts/gate/check-test-integrity.ts",
    "gate:local": "tsx scripts/gate/local.ts",
    "changeset": "changeset",
    "check:changeset": "tsx scripts/release/check-changeset.ts",
    "check:migracao": "tsx scripts/release/check-migracao.ts",
    "check:risco": "tsx scripts/release/classificar-risco.ts",
    "check:veredito": "tsx scripts/release/veredito-judge.ts",
    "release:sync": "bash scripts/release/sync-main.sh",
    "release:prepare": "tsx scripts/release/prepare.ts",
    "release:cut": "tsx scripts/release/cut.ts",
    "release:preflight": "tsx scripts/release/preflight.ts",
    "release:publish": "tsx scripts/release/publish.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "biome check --no-errors-on-unmatched --write"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@sentry/core": "10.75.3",
    "@still-void/ui": "^3.5.1",
    "drizzle-orm": "^0.45.2",
    "get-nonce": "^1.0.1",
    "googleapis": "^173.0.0",
    "next": "^16.3.6",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.5.12",
    "@changesets/cli": "^3.0.3",
    "@electric-sql/pglite": "^0.5.4",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.12",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.4.1",
    "msw": "3.0.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild": true
  },
  "overrides": {
    "@vitest/mocker": {
      "msw": "$msw"
    }
  }
}
